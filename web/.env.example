# Copy to .env.local and adjust. Only VITE_-prefixed vars are exposed to the browser.
# Keycloak base URL (realm "asseta", public PKCE client "asseta-web").
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=asseta
VITE_KEYCLOAK_CLIENT_ID=asseta-web
# API base path used by the browser. In dev, Vite proxies /api to VITE_DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
# Dev-server only (read by vite.config.ts, not shipped to the browser).
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
# MapLibre style JSON URL used by MapView.
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
