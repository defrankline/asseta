# Copy to .env and replace every CHANGE_ME. Never commit .env. Generate secrets e.g. `openssl rand -base64 32`.
ASSETA_ENVIRONMENT=development
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
ASSETA_OWNER_DB_PASSWORD=CHANGE_ME
ASSETA_APP_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
# MLflow backend-store database password (role `mlflow`, created by the mlflow-db-init service)
MLFLOW_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
ASSETA_API_CLIENT_SECRET=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=asseta-minio
MINIO_ROOT_PASSWORD=CHANGE_ME
# Shared secret: Traccar forward header <-> Asseta telemetry gateway (>= 24 chars)
ASSETA_TRACCAR_GATEWAY_KEY=CHANGE_ME
# Public URLs (what browsers/phones use; the token issuer is derived from the Keycloak URL)
ASSETA_PUBLIC_KEYCLOAK_URL=http://localhost:8080
ASSETA_WEB_URL=http://localhost:5173
# Host ports (127.0.0.1-bound); change if they collide with other local stacks
ASSETA_PG_PORT=5433
ASSETA_KEYCLOAK_PORT=8080
ASSETA_KAFKA_PORT=29192
ASSETA_REDIS_PORT=6380
ASSETA_MINIO_PORT=9100
ASSETA_MINIO_CONSOLE_PORT=9101
ASSETA_API_PORT=8000
ASSETA_WEB_PORT=5173
ASSETA_TRACCAR_PORT=8082
ASSETA_TRACCAR_OSMAND_PORT=5055
ASSETA_MLFLOW_PORT=5500

# --- SMS (backend/src/asseta/core/sms) ---
# console = log only (default, sends nothing); nextsms = real sends through NextSMS
ASSETA_SMS_PROVIDER=console
ASSETA_SMS_DEFAULT_COUNTRY_CODE=255
ASSETA_NEXTSMS_URL=https://messaging-service.co.tz/api/sms/v1/text/single
ASSETA_NEXTSMS_SENDER_ID=change-me
# Either username + password, or the pre-encoded Basic token (base64 of "username:password")
ASSETA_NEXTSMS_USERNAME=
ASSETA_NEXTSMS_PASSWORD=
ASSETA_NEXTSMS_AUTH_TOKEN=
# --- E-mail (backend/src/asseta/core/email) — console = log only (code default, sends nothing) ---
ASSETA_EMAIL_PROVIDER=console
ASSETA_EMAIL_FROM=Asseta <no-reply@asseta.local>
ASSETA_EMAIL_SMTP_HOST=
ASSETA_EMAIL_SMTP_PORT=587
ASSETA_EMAIL_SMTP_USERNAME=
ASSETA_EMAIL_SMTP_PASSWORD=
# starttls (default) | ssl (implicit TLS, usually 465) | none (local relay only)
ASSETA_EMAIL_SMTP_SECURITY=starttls
# Local development with the Mailpit container (`docker compose up -d mailpit`, inbox UI http://127.0.0.1:8025):
# ASSETA_EMAIL_PROVIDER=smtp
# ASSETA_EMAIL_SMTP_HOST=mailpit
# ASSETA_EMAIL_SMTP_PORT=1025
# ASSETA_EMAIL_SMTP_SECURITY=none
# ASSETA_MAILPIT_UI_PORT=8025
# --- Mobile push (backend/src/asseta/core/push) — console = log only (default) ---
# ANDROID: console | fcm (FCM HTTP v1)   IOS: console | apns (token-based .p8)
ASSETA_PUSH_ANDROID_PROVIDER=console
ASSETA_PUSH_IOS_PROVIDER=console
# Paths to key files mounted into notification-worker (never commit the files themselves)
ASSETA_PUSH_FCM_SERVICE_ACCOUNT_FILE=
ASSETA_PUSH_FCM_PROJECT_ID=
ASSETA_PUSH_APNS_KEY_FILE=
ASSETA_PUSH_APNS_KEY_ID=
ASSETA_PUSH_APNS_TEAM_ID=
ASSETA_PUSH_APNS_TOPIC=
# Supervisor app bundle id (com.asseta.supervisor); empty = no iOS pushes to the Supervisor app
ASSETA_PUSH_APNS_SUPERVISOR_TOPIC=
# production | sandbox (development builds)
ASSETA_PUSH_APNS_ENVIRONMENT=production
# --- Notifications (backend/src/asseta/modules/notification/settings.py); all optional, defaults shown ---
# ASSETA_NOTIFY_CHANNEL_MAX_ATTEMPTS=5
# ASSETA_NOTIFY_CHANNEL_RETRY_BASE_SECONDS=60
# ASSETA_NOTIFY_WEB_BASE_URL=http://localhost:5173
# ASSETA_NOTIFY_QUIET_HOURS_START=21
# ASSETA_NOTIFY_QUIET_HOURS_END=7
# ASSETA_NOTIFY_SMS_RATE_LIMIT_PER_HOUR=10
# ASSETA_NOTIFY_SMS_WALLET_LOW_THRESHOLD=50
# ASSETA_NOTIFY_APPROVAL_PENDING_HOURS=24
# ASSETA_NOTIFY_CASH_HANDOVER_CUTOFF_HOUR=19
# ASSETA_NOTIFY_INVOICE_DUE_SOON_DAYS=3

# Database safety valves for the API/worker role (optional; defaults shown; 0 disables) — docs/operating-runbook.md §10
# ASSETA_DB_LOCK_TIMEOUT_MS=5000
# ASSETA_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# ASSETA_DB_STATEMENT_TIMEOUT_MS=30000            # API requests (security.md F-7)
# ASSETA_WORKER_DB_STATEMENT_TIMEOUT_MS=300000    # background workers (compose.yaml); migrate/bootstrap: disabled

# Request limits (security.md F-5/F-6; docs/operating-runbook.md §2). Defaults shown.
# ASSETA_MAX_REQUEST_BYTES=11534336               # API body cap (11 MiB); keep in step with web/nginx.conf
# ASSETA_TRUSTED_PROXY_CIDR=127.0.0.1/32          # address of a TLS proxy in front of `web` (real client IP)
