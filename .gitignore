.env
*.env.local
.DS_Store
backend/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
# Local demo credentials written by backend/scripts/demo_seed.py (never commit)
.demo/

# Hardening drill state: throwaway tenant credentials (scripts/drills, never commit)
.drills/

# Claude Code agent worktrees (local only)
.claude/worktrees/

# Production deploy (scripts/deploy-live.sh, docs/deployment-live.md): real secrets, deploy state, the rendered
# nginx site and server-local compose overrides never enter git.
.env.*
!.env.example
!.env.production.example
.deploy/
deploy/nginx/runtime/
compose.prod.local.yaml
