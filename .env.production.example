# Asseta production configuration (shared server, https://asseta.co.tz). docs/deployment-live.md
#
# Do not copy this file by hand: `scripts/generate-production-secrets.sh` writes .env.production from it with strong
# random values for every secret marked GENERATED (mode 600; it refuses to overwrite an existing file). Then fill in
# the EXTERNAL values. scripts/deploy-live.sh refuses to run while any CHANGE_ME is left.
# Never commit .env.production. Format: KEY=value, one per line, no `export`. Quote values with spaces or < > in
# double quotes; values containing `$` in single quotes.

# --- Site ---------------------------------------------------------------------------------------------------------
DOMAIN=asseta.co.tz
ASSETA_WEB_URL=https://asseta.co.tz
# Public Keycloak base (token issuer = <this>/realms/asseta). Must match VITE_KEYCLOAK_URL (derived from it).
ASSETA_PUBLIC_KEYCLOAK_URL=https://asseta.co.tz/auth
# Host used in presigned evidence URLs (host nginx proxies /asseta-evidence/ to MinIO).
ASSETA_S3_PUBLIC_ENDPOINT=https://asseta.co.tz
ASSETA_S3_BUCKET=asseta-evidence
# EXTERNAL: Let's Encrypt registration / expiry notices.
LETSENCRYPT_EMAIL=CHANGE_ME

# --- Secrets (GENERATED by scripts/generate-production-secrets.sh) -----------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
ASSETA_OWNER_DB_PASSWORD=CHANGE_ME
ASSETA_APP_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
MLFLOW_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Confidential client `asseta-api` (imported into the realm on first start; rotate: docs/operating-runbook.md §3)
ASSETA_API_CLIENT_SECRET=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=asseta-minio
MINIO_ROOT_PASSWORD=CHANGE_ME
# Shared secret Traccar forward header <-> Asseta telemetry gateway (>= 24 chars)
ASSETA_TRACCAR_GATEWAY_KEY=CHANGE_ME

# --- SMS (EXTERNAL; console = log only, sends nothing) ----------------------------------------------------------
ASSETA_SMS_PROVIDER=console
ASSETA_SMS_DEFAULT_COUNTRY_CODE=255
ASSETA_NEXTSMS_URL=https://messaging-service.co.tz/api/sms/v1/text/single
# Set these and ASSETA_SMS_PROVIDER=nextsms to send real SMS. Username + password, or the Basic token.
ASSETA_NEXTSMS_SENDER_ID=
ASSETA_NEXTSMS_USERNAME=
ASSETA_NEXTSMS_PASSWORD=
ASSETA_NEXTSMS_AUTH_TOKEN=

# --- E-mail (EXTERNAL; console = log only) -----------------------------------------------------------------------
# smtp + host/port/credentials to send real e-mail. Keycloak's own mails (password reset) are configured in the
# Keycloak admin console (Realm settings -> Email), not here.
ASSETA_EMAIL_PROVIDER=console
ASSETA_EMAIL_FROM="Asseta <no-reply@asseta.co.tz>"
ASSETA_EMAIL_SMTP_HOST=
ASSETA_EMAIL_SMTP_PORT=587
ASSETA_EMAIL_SMTP_USERNAME=
ASSETA_EMAIL_SMTP_PASSWORD=
# starttls | ssl (implicit TLS, usually 465) | none (local relay only)
ASSETA_EMAIL_SMTP_SECURITY=starttls

# --- Mobile push (EXTERNAL; console = log only) ------------------------------------------------------------------
# ANDROID: console | fcm   IOS: console | apns. Key files are mounted read-only into notification-worker through
# compose.prod.local.yaml (docs/deployment-live.md); the *_FILE values are the paths inside the container.
ASSETA_PUSH_ANDROID_PROVIDER=console
ASSETA_PUSH_IOS_PROVIDER=console
ASSETA_PUSH_FCM_SERVICE_ACCOUNT_FILE=
ASSETA_PUSH_FCM_PROJECT_ID=
ASSETA_PUSH_APNS_KEY_FILE=
ASSETA_PUSH_APNS_KEY_ID=
ASSETA_PUSH_APNS_TEAM_ID=
ASSETA_PUSH_APNS_TOPIC=
# Supervisor app bundle id (com.asseta.supervisor); empty = no iOS pushes to the Supervisor app
ASSETA_PUSH_APNS_SUPERVISOR_TOPIC=
ASSETA_PUSH_APNS_ENVIRONMENT=production

# --- Console build (public, baked into the static files) ---------------------------------------------------------
VITE_API_BASE_URL=/api/v1
# Optional; default wss://<domain>/api/v1/ws (derived from the page origin + API base)
VITE_REALTIME_URL=
# MapLibre style JSON. Its tile/glyph/sprite origins must be listed in NGINX_MAP_CSP_ORIGINS.
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_CONTACT_EMAIL=
# Space-separated origins the map may load from (CSP img-src/connect-src/font-src).
NGINX_MAP_CSP_ORIGINS="https://demotiles.maplibre.org https://tile.openstreetmap.org https://*.tile.openstreetmap.org"

# --- Host ports (all bound to 127.0.0.1; bnbtracker uses 5010) -------------------------------------------------
ASSETA_API_HOST_PORT=5020
ASSETA_KEYCLOAK_HOST_PORT=5021
ASSETA_MINIO_HOST_PORT=5022
ASSETA_TRACCAR_UI_HOST_PORT=5023
ASSETA_MLFLOW_HOST_PORT=5024
# Keycloak admin console URL as seen through `ssh -L 5021:127.0.0.1:5021 <server>`
KEYCLOAK_ADMIN_URL=http://localhost:5021/auth
# Space-separated client IPs allowed to reach /auth/admin and the master realm through nginx (default: none).
KEYCLOAK_ADMIN_ALLOW_IPS=

# --- GPS trackers ------------------------------------------------------------------------------------------------
# 1 = publish the Traccar OsmAnd port on 0.0.0.0 (open it in the firewall; docs/deployment-live.md). 0 = 127.0.0.1.
TRACCAR_PUBLIC_DEVICE_PORTS=0
ASSETA_TRACCAR_OSMAND_PORT=5055
TRACCAR_REGISTER_UNKNOWN=false

# --- Host nginx / certbot / static files -------------------------------------------------------------------------
WEB_ROOT_BASE=/var/www/html/asseta.co.tz
WEB_ROOT_OWNER=www-data:www-data
INSTALL_NGINX_CONFIG=1
# auto | sites (sites-available + sites-enabled) | conf.d
NGINX_SITE_MODE=auto
ENABLE_LETSENCRYPT=1
CERTBOT_COMMAND=certbot

# --- Deploy housekeeping (this project only) ---------------------------------------------------------------------
KEEP_DOCKER_IMAGES=2
KEEP_FRONTEND_RELEASES=2
# Global Docker cleanup affects other projects on the host: leave 0 unless you mean it.
ENABLE_DANGLING_PRUNE=0
ENABLE_BUILDER_PRUNE=0
MIN_FREE_DISK_GB=10

# --- Backups (scripts/backup-live.sh) ----------------------------------------------------------------------------
BACKUP_ROOT=/home/asseta/backups
BACKUP_RETENTION_DAYS=7
# Optional rsync target for an off-host copy, e.g. backup@nas.example:/srv/backups/asseta
BACKUP_REMOTE=

# --- Optional tuning (defaults shown; docs/operating-runbook.md §10) --------------------------------------------
# ASSETA_DB_LOCK_TIMEOUT_MS=5000
# ASSETA_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# ASSETA_DB_STATEMENT_TIMEOUT_MS=30000
# ASSETA_WORKER_DB_STATEMENT_TIMEOUT_MS=300000
# ASSETA_MAX_REQUEST_BYTES=11534336

# MLflow experiment tracking (optional, ~1.4 GB RAM). 0 (default): not started; model training still records every run
# in the database. 1: start MLflow (UI on 127.0.0.1:${ASSETA_MLFLOW_HOST_PORT:-5024}) and send runs to it.
ENABLE_MLFLOW=0
